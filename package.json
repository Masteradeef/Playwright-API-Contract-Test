{
  "name": "playwright-api-contract-test",
  "version": "1.0.0",
  "description": "Scalable Playwright framework for API contract testing with Zod schema validation and Pact CDCT",
  "scripts": {
    "test": "npx playwright test",
    "test:schema": "npx playwright test --grep @schema",
    "test:contract": "npx playwright test --grep @contract",
    "test:api": "npx playwright test --grep @api",
    "pact:publish": "ts-node src/pact/publish.ts",
    "lint": "eslint src/ tests/"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@pact-foundation/pact": "^13.2.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0",
    "dotenv": "^16.4.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
